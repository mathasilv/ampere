<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Motor de cálculo PURO: proibido referenciar Autodesk.Revit.* (guardado por ArquiteturaDoNucleo_Teste).
        net8.0 carrega tanto no Revit 2025/2026 (.NET 8) quanto no Revit 2027 (.NET 10).
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Referenciado pelo add-in com Configuration=Release.R20XX: o SDK só otimiza quando o nome é "Release". -->
        <Optimize Condition="'$(Optimize)' == '' And $(Configuration.StartsWith('Release'))">true</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\..\data\parametros\parametros_compartilhados_ampere.json"
                          LogicalName="Ampere.Core.Parametros.parametros_compartilhados_ampere.json"/>
        <EmbeddedResource Include="..\..\data\normas\NBR5410\2004\perfil.json"
                          LogicalName="Ampere.Core.Normas.NBR5410_2004.perfil.json"/>
        <EmbeddedResource Include="..\..\data\normas\NBR5410\2004\previsao_de_cargas.json"
                          LogicalName="Ampere.Core.Previsao.NBR5410_2004.previsao_de_cargas.json"/>
        <EmbeddedResource Include="..\..\data\normas\NBR5410\2004\dps.json"
                          LogicalName="Ampere.Core.Surtos.NBR5410_2004.dps.json"/>
        <EmbeddedResource Include="..\..\data\catalogos\condutores.json"
                          LogicalName="Ampere.Core.Catalogos.condutores.json"/>
        <EmbeddedResource Include="..\..\data\catalogos\eletrodutos.json"
                          LogicalName="Ampere.Core.Catalogos.eletrodutos.json"/>
        <EmbeddedResource Include="..\..\data\distribuidoras\CELG\CT-04-2018\demanda.json"
                          LogicalName="Ampere.Core.Demanda.CELG_CT-04-2018.demanda.json"/>
        <EmbeddedResource Include="..\..\data\distribuidoras\EQTL\NT.00001-09\padrao_de_entrada.json"
                          LogicalName="Ampere.Core.Demanda.EQTL_NT.00001-09.padrao_de_entrada.json"/>
    </ItemGroup>

    <!--
        Relatório em PDF (escolha do usuário, 29/09/2026): PDFsharp (MIT, sem GDI). Fontes DejaVu 2.35 embutidas: a mesma
        métrica em qualquer máquina e todos os símbolos da memória (Δ θ ρ Ω ≤ ∈ √ ₀); licença em Relatorios/Fontes.
    -->
    <ItemGroup>
        <PackageReference Include="PDFsharp" Version="6.2.4"/>
        <EmbeddedResource Include="Relatorios\Fontes\*.ttf" LogicalName="Ampere.Core.Relatorios.Fontes.%(Filename)%(Extension)"/>
        <EmbeddedResource Include="Relatorios\Fontes\LICENSE_DEJAVU" LogicalName="Ampere.Core.Relatorios.Fontes.LICENSE_DEJAVU"/>
    </ItemGroup>

    <ItemGroup>
        <!-- A diagramação do PDF é interna; os testes a exercitam com um medidor de texto falso. -->
        <InternalsVisibleTo Include="Ampere.Tests.Core"/>
    </ItemGroup>

</Project>
