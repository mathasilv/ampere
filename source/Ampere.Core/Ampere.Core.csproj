<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Motor de cálculo PURO: proibido referenciar Autodesk.Revit.* (guardado por ArquiteturaDoNucleo_Teste).
        net8.0 carrega tanto no Revit 2025/2026 (.NET 8) quanto no Revit 2027 (.NET 10).
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Referenciado pelo add-in com Configuration=Release.R20XX: o SDK só otimiza quando o nome é "Release". -->
        <Optimize Condition="'$(Optimize)' == '' And $(Configuration.StartsWith('Release'))">true</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\..\data\parametros\parametros_compartilhados_ampere.json"
                          LogicalName="Ampere.Core.Parametros.parametros_compartilhados_ampere.json"/>
    </ItemGroup>

</Project>
